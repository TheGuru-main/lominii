/* ===== DASHBOARD HEADER ===== */

/* =========================================================
   LOMINII — dashboard.css
   Header shell shared by every workspace
   ========================================================= */

.header{
    position: sticky;
    top: 0;
    z-index: 15;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-sm) var(--space-md);
    background: var(--surface);
    border-bottom: 1px solid var(--glass-hi);
}

.header .logo{
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 700;
    font-size: 1.1rem;
    letter-spacing: 0.01em;
}

.logo-icon{
    font-size: 1.3rem;
}

.user-icon{
    position: relative;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--accent);
    color: #0B1524;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    cursor: pointer;
}

.dropdown{
    position: absolute;
    top: calc(100% + 0.6rem);
    right: 0;
    min-width: 200px;
    display: none;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--glass-hi);
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: 0 12px 32px rgba(0,0,0,0.35);
}

.dropdown.show,
.dropdown.open{
    display: flex;
}

.dropdown a{
    padding: 0.75rem 1rem;
    font-size: 0.9rem;
    color: var(--text-secondary);
    transition: background var(--speed) var(--ease);
}

.dropdown a:hover{
    background: var(--soft-surface);
    color: var(--text);
}

.main-content{
    min-height: calc(100vh - 64px);
    padding-bottom: calc(80px + env(safe-area-inset-bottom));
}

.media-carousels { margin-bottom: 1.5rem; }
.carousel {
  margin-bottom: 1rem;
}

.carousel h4 { margin-bottom: 0.5rem; color: var(--color-text-secondary); }
.carousel-track {
  display: flex;
  gap: 1rem;
  overflow-x: auto;
  padding-bottom: 0.5rem;
}


/* ===== BACK BUTTON ===== */

.back-toggle{
    position: fixed;
    top: var(--space-sm);
    left: var(--space-sm);
    z-index: 25;
    color: var(--text-secondary);
    font-size: 0.85rem;
    padding: 0.5rem 0.9rem;
    border-radius: var(--radius-sm);
    background: var(--glass);
    border: 1px solid var(--glass-hi);
    display: none;
}

.workspace-view .back-toggle {
  display: block;
}



/* ── LOMINII account/profile panel ─────────────────────── */
.lm-account-overlay[hidden] {
  display: none !important;
}

.lm-account-overlay {
  position: fixed;
  inset: 0;
  z-index: 10000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 1rem;
  overflow-y: auto;
  background: rgba(5, 12, 25, .78);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
}

.lm-account-card {
  width: min(100%, 560px);
  max-height: min(88vh, 820px);
  overflow-y: auto;
  padding: 1.25rem;
  border: 1px solid rgba(255, 255, 255, .18);
  border-radius: 22px;
  background: #152236;
  color: #f8fafc;
  box-shadow: 0 24px 70px rgba(0, 0, 0, .4);
}

.lm-account-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 1rem;
  margin-bottom: 1rem;
}

.lm-account-eyebrow {
  margin-bottom: .25rem;
  color: #93c5fd;
  font-size: .72rem;
  font-weight: 800;
  letter-spacing: .12em;
}

.lm-account-header h2 {
  font-size: 1.45rem;
}

.lm-account-close {
  flex: 0 0 auto;
  width: 38px;
  height: 38px;
  border: 1px solid rgba(255, 255, 255, .2);
  border-radius: 12px;
  font-size: 1.6rem;
}

.lm-account-section {
  margin-top: 1rem;
  padding: 1rem;
  border: 1px solid rgba(255, 255, 255, .13);
  border-radius: 16px;
  background: rgba(255, 255, 255, .045);
}

.lm-account-section h3 {
  margin-bottom: .65rem;
  font-size: 1rem;
}

.lm-account-section p {
  margin: .45rem 0;
  color: #cbd5e1;
  font-size: .92rem;
  line-height: 1.55;
}

.lm-account-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 1rem;
  padding: .65rem 0;
  border-bottom: 1px solid rgba(255, 255, 255, .09);
  font-size: .9rem;
}

.lm-account-row span {
  color: #aebdd0;
}

.lm-account-row strong {
  max-width: 62%;
  overflow-wrap: anywhere;
  text-align: right;
}

.lm-account-note {
  margin-top: .8rem !important;
  font-size: .8rem !important;
}

.lm-account-actions {
  display: flex;
  flex-wrap: wrap;
  gap: .6rem;
  margin-top: 1rem;
}

.lm-account-actions button {
  min-height: 44px;
  padding: .7rem 1rem;
  border-radius: 12px;
  font-weight: 700;
}

.lm-account-primary {
  background: #4da3ff;
  color: #0b1524;
}

.lm-account-secondary {
  border: 1px solid rgba(255, 255, 255, .25);
  color: #f8fafc;
}

@media (max-width: 480px) {
  .lm-account-card {
    padding: .9rem;
    border-radius: 18px;
  }

  .lm-account-row {
    flex-direction: column;
    gap: .25rem;
  }

  .lm-account-row strong {
    max-width: 100%;
    text-align: left;
  }
}
