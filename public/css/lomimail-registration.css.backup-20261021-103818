/* Lomimail registration modal — scoped styles only */
.lm-overlay[hidden],
.lm-card [hidden],
.lm-field [hidden] {
  display: none !important;
}
.lm-overlay {
  position: fixed;
  inset: 0;
  z-index: 10000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16px;
  background: rgba(5, 12, 24, 0.78);
  backdrop-filter: blur(9px);
  overflow-y: auto;
}
.lm-card {
  width: min(760px, 100%);
  max-height: calc(100dvh - 32px);
  overflow-y: auto;
  padding: clamp(18px, 4vw, 30px);
  border: 1px solid rgba(255,255,255,.2);
  border-radius: 22px;
  color: #f8fafc;
  background: linear-gradient(145deg, #111827, #1f2937 65%, #111827);
  box-shadow: 0 24px 80px rgba(0,0,0,.45);
}
.lm-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18px;
  margin-bottom: 20px;
}
.lm-eyebrow {
  margin: 0 0 6px;
  color: #93c5fd;
  font-size: .76rem;
  font-weight: 800;
  letter-spacing: .13em;
}
.lm-top h2 {
  margin: 0 0 8px;
  font-size: clamp(1.35rem, 4vw, 1.8rem);
  line-height: 1.2;
}
.lm-intro {
  margin: 0;
  color: #cbd5e1;
  font-size: .94rem;
}
.lm-close {
  flex: 0 0 auto;
  width: 38px;
  height: 38px;
  border: 1px solid rgba(255,255,255,.2);
  border-radius: 12px;
  color: #fff;
  background: rgba(255,255,255,.08);
  font-size: 1.55rem;
  cursor: pointer;
}
.lm-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14px;
}
.lm-field {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: 7px;
  margin-bottom: 14px;
}
.lm-field label {
  color: #e5e7eb;
  font-size: .88rem;
  font-weight: 650;
}
.lm-field input,
.lm-field select {
  box-sizing: border-box;
  width: 100%;
  min-height: 46px;
  padding: 11px 12px;
  border: 1px solid rgba(203,213,225,.27);
  border-radius: 11px;
  outline: none;
  color: #f8fafc;
  background: rgba(15,23,42,.88);
  font: inherit;
}
.lm-field select option,
.lm-field select optgroup {
  color: #111827;
  background: #fff;
}
.lm-field input::placeholder {
  color: #94a3b8;
}
.lm-field input:focus,
.lm-field select:focus {
  border-color: #60a5fa;
  box-shadow: 0 0 0 3px rgba(96,165,250,.16);
}
.lm-hint {
  margin: 0 0 14px;
  color: #aebccd;
  font-size: .8rem;
  line-height: 1.5;
}
.lm-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin: 12px 0 16px;
}
.lm-button {
  min-height: 46px;
  padding: 12px 18px;
  border: 0;
  border-radius: 12px;
  font: inherit;
  font-weight: 750;
  cursor: pointer;
}
.lm-button:disabled {
  cursor: wait;
  opacity: .65;
}
.lm-primary {
  color: #0b1220;
  background: #93c5fd;
}
.lm-secondary {
  border: 1px solid rgba(255,255,255,.2);
  color: #f8fafc;
  background: rgba(255,255,255,.09);
}
.lm-status {
  margin: 4px 0 12px;
  padding: 0;
  font-size: .9rem;
  line-height: 1.5;
  overflow-wrap: anywhere;
}
.lm-status:empty {
  display: none;
}
.lm-status.lm-error,
.lm-status.lm-success,
.lm-status.lm-info {
  padding: 10px 12px;
  border-radius: 10px;
}
.lm-status.lm-error {
  color: #fecaca;
  background: rgba(127,29,29,.32);
}
.lm-status.lm-success {
  color: #bbf7d0;
  background: rgba(20,83,45,.35);
}
.lm-status.lm-info {
  color: #bfdbfe;
  background: rgba(30,64,175,.25);
}
@media (max-width: 600px) {
  .lm-overlay {
    align-items: flex-start;
    padding: 8px;
  }
  .lm-card {
    max-height: calc(100dvh - 16px);
    padding: 18px 14px;
    border-radius: 16px;
  }
  .lm-grid {
    grid-template-columns: minmax(0, 1fr);
    gap: 0;
  }
  .lm-actions {
    flex-direction: column;
  }
  .lm-button {
    width: 100%;
  }
}
